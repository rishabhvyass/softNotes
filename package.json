{
  "name": "soft-notes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api": "bun --hot apps/api/src/server.ts",
    "api:start": "bun apps/api/src/server.ts",
    "api:test": "bun test apps/api",
    "mobile:start": "npm --prefix apps/mobile start -- --port 8088 --max-workers 2",
    "mobile:ios": "npm --prefix apps/mobile run ios -- --port 8088",
    "mobile:android": "npm --prefix apps/mobile run android -- --port 8088",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:test": "npm --prefix apps/mobile test -- --runInBand",
    "typecheck": "bun run typecheck:api && npm --prefix apps/mobile run typecheck",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "check": "npm run typecheck && npm run mobile:lint && npm run api:test && npm run mobile:test"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.11.0"
  }
}

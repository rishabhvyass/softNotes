{
  "name": "soft-notes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api": "bun --hot apps/api/src/server.ts",
    "api:start": "bun apps/api/src/server.ts",
    "api:test": "bun test apps/api",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:test": "npm --prefix apps/mobile run test",
    "typecheck": "bun run typecheck:api && npm --prefix apps/mobile run typecheck",
    "typecheck:api": "bunx tsc -p apps/api/tsconfig.json"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.11.0"
  }
}

